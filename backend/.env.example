# Copy to backend/.env and fill in. NEVER commit the filled file.
#
# Every setting the app reads is listed here, in the order it appears in
# app/core/config.py. Anything left blank or absent falls back to the default
# in that file -- which for development is always something that works without
# a vendor account.
#
# No inline comments after a value: this file is read by python-dotenv, which
# would keep "value # comment" as part of the value.

# --- environment ------------------------------------------------------------
APP_ENV=development
# Signs every access token. Generate with: openssl rand -hex 32
SECRET_KEY=
# Comma-separated. The browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- database ---------------------------------------------------------------
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# A password containing @ / : # or ? must be percent-encoded here, which is why
# `openssl rand -hex 24` is the recommended way to make one.
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5432/sahaya

# --- tokens -----------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- providers: the whole outside world, in five lines ----------------------
# console | smtp
EMAIL_BACKEND=console
# console | msg91
SMS_BACKEND=console
# local | s3   (s3 is not implemented yet)
STORAGE_BACKEND=local
# rembg | noop (noop = no background removal; cards use the circular crop)
IMAGING_BACKEND=rembg
# openai | none
ASSISTANT_BACKEND=openai

# --- storage ----------------------------------------------------------------
STORAGE_LOCAL_DIR=var/uploads
# The public prefix for uploaded images. Must be absolute when the site and the
# API are on different origins, so a card can load a photo cross-origin.
STORAGE_PUBLIC_BASE=/media

# --- smtp (when EMAIL_BACKEND=smtp) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sahaya <no-reply@sahaya.life>

# --- msg91 (when SMS_BACKEND=msg91; needs TRAI DLT registration) ------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=

# --- sign-in with Google / Apple --------------------------------------------
GOOGLE_CLIENT_ID=
# iOS only; leave blank until there is an app.
APPLE_CLIENT_ID=

# --- razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- OTP policy (docs/04-auth-flows.md) -------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- price ------------------------------------------------------------------
# Rs 99.00, in paise. Changing this does not change an existing Razorpay plan.
SUBSCRIPTION_AMOUNT_PAISE=9900

# --- Ask Sahaya, the in-chat assistant (docs/DECISIONS.md 023) --------------
# The key is the only switch. Empty means the assistant is hidden everywhere
# and its endpoints answer 503 with a sentence saying what to do.
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-5-nano
# Per account per day. This is what bounds the bill.
ASSISTANT_DAILY_MESSAGE_LIMIT=40
ASSISTANT_HISTORY_TURNS=20
ASSISTANT_MAX_OUTPUT_TOKENS=700
ASSISTANT_TIMEOUT_SECONDS=30
