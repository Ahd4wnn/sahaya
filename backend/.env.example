# Copy to backend/.env and fill in. NEVER commit the filled file.

APP_ENV=development
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# --- database ---
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5432/sahaya

# --- tokens ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- providers: console | smtp / msg91 / s3 / rembg | noop ---
EMAIL_BACKEND=console
SMS_BACKEND=console
STORAGE_BACKEND=local
IMAGING_BACKEND=rembg

STORAGE_LOCAL_DIR=var/uploads
STORAGE_PUBLIC_BASE=/media

# --- smtp (when EMAIL_BACKEND=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- msg91 (when SMS_BACKEND=msg91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=

# --- google oauth ---
GOOGLE_CLIENT_ID=

# --- apple sign in (iOS) ---
APPLE_CLIENT_ID=

# --- razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- ask sahaya, the in-chat assistant ---
# Paste the OpenAI key here and restart the server: that is the only switch.
# With it empty the assistant is hidden everywhere and its endpoints say 503.
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-5-nano
ASSISTANT_DAILY_MESSAGE_LIMIT=40
