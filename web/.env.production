# Build-time config for the production bundle.
#
# Everything here ends up in the JavaScript that browsers download, so it must
# only ever hold public values -- Vite exposes VITE_* to the client by design.
# Secrets belong in backend/.env, which is gitignored.
#
# The site is sahaya.life and the API is api.sahaya.life, so the bundle needs
# to be told where to call. Override it for a one-off build with:
#   VITE_API_URL=https://staging-api.example.com npm run build
VITE_API_URL=https://api.sahaya.life
